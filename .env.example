# =============================================================================
# Campus Guide Kiosk - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit the actual .env file to version control
# =============================================================================

# ============= FLASK CONFIGURATION =============
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ============= ENVIRONMENT =============
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============= FIREBASE CONFIGURATION =============
# Path to Firebase service account key JSON file
FIREBASE_KEY_PATH=firebase/campus_guide_kiosk.json

# Firebase collection names
FAQ_COLLECTION=faqs
EVENTS_COLLECTION=events
QUERY_LOGS_COLLECTION=query_logs

# ============= GOOGLE GEMINI API =============
# Add multiple API keys separated by commas for key rotation
# Example: key1,key2,key3
GEMINI_API_KEYS=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=30

# ============= EMBEDDING MODEL =============
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============= SEARCH & RANKING =============
# Minimum confidence score (0.0-1.0) for FAQ matches
ANSWER_MIN_SCORE=0.5

# ============= CACHING =============
# Maximum number of queries to cache (LRU cache)
CACHE_MAX_SIZE=128

# ============= RATE LIMITING =============
RATE_LIMIT_ENABLED=True
RATE_LIMIT_RPM=60
RATE_LIMIT_RPH=1000

# Number of trusted reverse proxy hops in front of this app (e.g. nginx = 1).
# Only set this if the app is actually behind that many trusted proxies —
# it makes Flask trust the client-supplied X-Forwarded-For/Proto headers,
# which is required for accurate rate limiting/logging behind a proxy but
# would let clients spoof their IP if there is no proxy in front.
TRUSTED_PROXY_COUNT=0

# ============= ADMIN AUTHENTICATION =============
# Required to protect /api/v1/reload and /api/v1/analytics. If unset, those
# endpoints are open to anyone — always set a strong random value in
# production: python -c "import secrets; print(secrets.token_urlsafe(32))"
RELOAD_SECRET=

# ============= SECURITY =============
# Allowed CORS origins (comma-separated, use * for localhost development)
CORS_ORIGINS=*

# Maximum allowed query length in characters
MAX_QUERY_LENGTH=500

# Enable input sanitization
SANITIZE_INPUT=True

# ============= OPTIONAL: ADMIN RELOAD WEBHOOK =============
# Uncomment and set this if admin_tool.py should notify app.py of changes
# APP_RELOAD_URL=http://localhost:5000/api/v1/reload

# ============= OPTIONAL: ANALYTICS =============
# Enable query analytics logging
ENABLE_ANALYTICS=True

# ============= OPTIONAL: SENTRY ERROR TRACKING =============
# Uncomment if using Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============= LEGACY FIREBASE CLIENT CONFIG (for frontend) =============
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_APP_ID=your_firebase_app_id
